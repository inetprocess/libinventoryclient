{
    "name": "inetprocess/libinventoryclient",
    "description": "This library provides various classes to get information about a SugarCRM Installation",
    "type": "library",
    "keywords": ["sugarcrm"],
    "authors": [
        {
            "name": "Rémi Sauvat",
            "email": "remi.sauvat@inetprocess.com"
        }
    ],
    "repositories": [
     {
        "type": "vcs",
        "url": "https://github.com/inetprocess/libsugarcrm"
      }
    ],
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "inetprocess/libsugarcrm": "dev-feature/php82-update",
        "linfo/linfo": "^4.0",
        "psr/log": "^3.0",
        "symfony/finder": "^6.4",
        "symfony/process": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Inet\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inet\\Inventory\\Tests\\": "tests/"
        }
    }
}
