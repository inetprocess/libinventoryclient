{
    "name": "inetprocess/libinventoryclient",
    "description": "This library provides various classes to get information about a SugarCRM Installation",
    "type": "library",
    "keywords": ["sugarcrm"],
    "authors": [
        {
            "name": "Rémi Sauvat",
            "email": "remi.sauvat@inetprocess.com"
        }
    ],
    "repositories": [
     {
        "type": "vcs",
        "url": "https://github.com/inetprocess/libsugarcrm"
      }
    ],
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.0",
        "guzzlehttp/guzzle": "~6.5.8",
        "inetprocess/libsugarcrm": "v2.0.2",
        "linfo/linfo": "^3.0",
        "psr/log": "2.0.0",
        "symfony/finder": "~5",
        "symfony/process": "~5"
    },
    "require-dev": {
        "phpunit/phpunit": "10"
    },
    "autoload": {
        "psr-4": {
            "Inet\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inet\\Inventory\\Tests\\": "tests/"
        }
    }
}
